{
  "name": "memorial-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node scripts/images.mjs && astro build",
    "check": "node scripts/images.mjs && astro check",
    "start": "node scripts/start.mjs",
    "password:hash": "node scripts/password.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:access": "node scripts/access-test.mjs",
    "test:dev": "node scripts/dev-access-test.mjs",
    "test:compose": "node scripts/compose-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "astro": "^7.3.6",
    "chokidar": "^5.0.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "A simple memorial website with public and password-protected photo galleries, built with Astro.",
  "author": "Danny Zander",
  "license": "MIT"
}
