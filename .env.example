# Docker Compose >= 2.30; use unquoted values (format: raw).
AUTH_PASSWORD_HASH=scrypt$REPLACE_WITH_GENERATED_HASH
AUTH_COOKIE_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Local development; use the public HTTPS origin in production.
SITE_ORIGIN=http://localhost:4321
TRUST_PROXY=false
IMAGE=ghcr.io/OWNER/REPOSITORY:latest
HTTP_PORT=4321
