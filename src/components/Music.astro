<section class="music" aria-labelledby="music-title">
  <h2 id="music-title">Musik, die erinnert</h2>
  <div class="players">
    <article class="player">
      <h3>YouTube</h3>
      <div class="placeholder">
        <p>Wenn du den Player lädst, wird eine Verbindung zu YouTube hergestellt. Dabei können personenbezogene Daten wie deine IP-Adresse übermittelt und Cookies gesetzt werden.</p>
        <button type="button" class="load-player">YouTube-Player laden</button>
        <a href="https://www.youtube.com/watch?v=psuRGfAaju4" target="_blank" rel="noopener noreferrer">Direkt auf YouTube öffnen</a>
        <a href="https://policies.google.com/privacy?hl=de" target="_blank" rel="noopener noreferrer">Datenschutzhinweise von Google</a>
      </div>
      <div class="embed youtube" hidden></div>
      <template>
        <iframe width="560" height="315" src="https://www.youtube-nocookie.com/embed/psuRGfAaju4?si=Pv5yTRCrTWc2GbgH" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </template>
      <button type="button" class="unload-player quiet" hidden>Player schließen</button>
    </article>
    <article class="player">
      <h3>Spotify</h3>
      <div class="placeholder">
        <p>Wenn du den Player lädst, wird eine Verbindung zu Spotify hergestellt. Dabei können personenbezogene Daten wie deine IP-Adresse übermittelt und Cookies gesetzt werden.</p>
        <button type="button" class="load-player">Spotify-Player laden</button>
        <a href="https://open.spotify.com/track/11hcBLPtbMp4aQI6zGQLub" target="_blank" rel="noopener noreferrer">Direkt auf Spotify öffnen</a>
        <a href="https://www.spotify.com/de/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Datenschutzhinweise von Spotify</a>
      </div>
      <div class="embed spotify" hidden></div>
      <template>
        <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/track/11hcBLPtbMp4aQI6zGQLub?utm_source=generator&amp;theme=0&amp;si=898ecc1773de4313" title="Spotify music player" width="100%" height="152" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </template>
      <button type="button" class="unload-player quiet" hidden>Player schließen</button>
    </article>
  </div>
  <noscript><p>Zum Laden der Player ist JavaScript erforderlich. Du kannst die Musik über die direkten Links öffnen.</p></noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.music .player').forEach(player => {
    const placeholder = player.querySelector<HTMLElement>('.placeholder')!;
    const embed = player.querySelector<HTMLElement>('.embed')!;
    const template = player.querySelector<HTMLTemplateElement>('template')!;
    const load = player.querySelector<HTMLButtonElement>('.load-player')!;
    const unload = player.querySelector<HTMLButtonElement>('.unload-player')!;

    load.addEventListener('click', () => {
      embed.replaceChildren(template.content.cloneNode(true));
      placeholder.hidden = true;
      embed.hidden = false;
      unload.hidden = false;
      unload.focus();
    });
    unload.addEventListener('click', () => {
      embed.replaceChildren();
      embed.hidden = true;
      unload.hidden = true;
      placeholder.hidden = false;
      load.focus();
    });
  });
</script>

<style>
  .music { margin-bottom: 48px; }
  h2 { margin: 0 0 24px; text-align: center; font-family: Georgia, serif; font-size: 28px; font-weight: 400; }
  .players { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .player { min-width: 0; padding: 24px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); }
  h3 { margin: 0 0 16px; font-size: 16px; font-weight: 500; }
  .placeholder { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .placeholder p { margin: 0; color: var(--secondary); font-size: 14px; line-height: 1.7; }
  .placeholder a { font-size: 14px; }
  .embed :global(iframe) { display: block; width: 100%; border: 0; }
  .youtube :global(iframe) { height: auto; aspect-ratio: 16 / 9; border-radius: 4px; }
  .spotify :global(iframe) { height: 152px; }
  .unload-player { margin-top: 16px; font-size: 14px; }
  [hidden] { display: none; }
  @media (max-width: 600px) { .players { grid-template-columns: 1fr; gap: 20px; } .player { padding: 20px; } }
</style>
