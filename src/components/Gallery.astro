---
interface Photo { thumb: { url: string; width: number; height: number }; large: { url: string; width: number; height: number }; }
interface Props { photos: Photo[]; }
const { photos } = Astro.props;
---
<div class="gallery" aria-label="Fotogalerie">
  {photos.map(photo => (
    <figure>
      <a href={photo.large.url} target="_blank" rel="noopener">
        <img src={photo.thumb.url} width={photo.thumb.width} height={photo.thumb.height} loading="lazy"/>
      </a>
    </figure>
  ))}
</div>
