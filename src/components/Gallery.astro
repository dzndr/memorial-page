---
interface ImageItem { type: 'image'; thumb: { url: string; width: number; height: number }; large: { url: string; width: number; height: number }; objectPosition?: string; }
interface YouTubeItem { type: 'youtube'; src: string; }
interface Props { gallery: Array<ImageItem | YouTubeItem>; }
const { gallery } = Astro.props;
---
<div class="gallery" aria-label="Fotogalerie">
  {gallery.map(item => item.type === 'youtube' ? (
    <div class="youtube-wrapper">
      <iframe src={item.src} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
    ) : (
    <figure>
      <a href={item.large.url} class="photo-wrapper">
        <img src={item.thumb.url} width={item.thumb.width} height={item.thumb.height} style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined} loading="lazy" alt="" />
      </a>
    </figure>
  ))}
</div>

<script>
import 'simplelightbox/dist/simple-lightbox.min.css';

if (!('global' in globalThis)) {
  Object.defineProperty(globalThis, 'global', { value: globalThis, configurable: true });
}

const { default: SimpleLightbox } = await import('simplelightbox/dist/simple-lightbox.esm.js');

new SimpleLightbox('.gallery a', {
  animationSpeed: 100,
  overlayOpacity: 0.8,
  alertErrorMessage: 'Das Bild konnte nicht geladen werden.'
});
</script>

<style>
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, 240px);
  grid-auto-rows: 240px;
  justify-content: center;
  gap: 16px;
  padding: 16px;
}

figure {
  margin: 0;
}

.photo-wrapper {
  display: block;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 4px;
  background: var(--image-background);
}

.gallery img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.gallery a:hover img {
  transform: scale(1.025);
}

figcaption {
  padding: 16px 0;
  color: var(--secondary);
  font-size: 14px;
}

.youtube-wrapper {
  grid-column: span 2;
  width: 100%;
  height: 100%;
  border-radius: 4px;
  overflow: hidden;
}

.youtube-wrapper iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

@media (max-width: 600px) {
  .gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: calc((100vw - 64px) / 2);
  }
}

@media (prefers-reduced-motion: reduce) {
  .gallery img {
    transition: none;
  }
}
</style>

<style is:global>
.sl-overlay {
  background: var(--background) !important;
}

.sl-navigation button, .sl-close, .sl-counter {
  color: var(--text) !important;
}
</style>
