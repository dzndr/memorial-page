---
interface Photo { thumb: { url: string; width: number; height: number }; large: { url: string; width: number; height: number }; }
interface Props { photos: Photo[]; }
const { photos } = Astro.props;
---
<div class="gallery" aria-label="Fotogalerie">
  {photos.map(photo => (
    <figure>
      <a href={photo.large.url}>
        <img src={photo.thumb.url} width={photo.thumb.width} height={photo.thumb.height} loading="lazy"/>
      </a>
    </figure>
  ))}
</div>

<script>
import SimpleLightbox from 'simplelightbox';
import 'simplelightbox/dist/simple-lightbox.min.css';
new SimpleLightbox('.gallery a', {
  captionsData: 'alt',
  captionPosition: 'bottom',
  animationSpeed: 250,
  closeText: '×',
  navText: ['←', '→'],
  alertErrorMessage: 'Das Bild konnte nicht geladen werden.'
});
</script>