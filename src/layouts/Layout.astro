---
interface Props { title: string; lifeDates?: string; privatePage?: boolean; isLoggedIn?: boolean; }
const { title, lifeDates, privatePage = false, isLoggedIn = false } = Astro.props;
const isPrivateGallery = Astro.url.pathname === '/private' || Astro.url.pathname.startsWith('/private/');
---
<!doctype html>
<html lang="de">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={privatePage ? 'noindex, nofollow' : 'index, follow'}/><title>{title}</title></head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <header>
    <span class="brand">Erinnerungen</span>
    <nav aria-label="Hauptnavigation">
      {privatePage ? <a href="/">Öffentliche Galerie</a> : <span aria-current="page">Öffentliche Galerie</span>}
      {privatePage ? <span aria-current="page">Privater Bereich</span> : <a href="/private/">Privater Bereich</a>}
      {isLoggedIn && <form method="post" action="/api/logout"><button class="quiet" type="submit">Abmelden</button></form>}
    </nav>
  </header>
  <main id="inhalt"><div class="heading"><span class="eyebrow">Was bleibt, ist die Liebe</span><h1>{title}</h1>{lifeDates && <p class="dates">{lifeDates}</p>}<span class="line" aria-hidden="true"></span></div><slot/></main>
  <footer>Ein Ort für Erinnerungen.</footer>
</body>
</html>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#434840;background:#faf9f5;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}header{max-width:1160px;margin:auto;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #e4e5dc}.brand{font-family:Georgia,serif;font-size:23px;text-decoration:none}nav{display:flex;align-items:center;gap:24px;font-size:14px}nav a{cursor:pointer}nav a:hover{cursor:pointer}nav [aria-current="page"]{text-decoration:none;cursor:default}nav form{margin:0}main{max-width:1100px;margin:auto;padding:64px 32px}.heading{text-align:center;margin-bottom:40px}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:.2em;color:#727865}h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(32px,5vw,52px);line-height:1.15;margin:20px 0}.dates{color:#727865}.line{display:block;width:44px;height:1px;background:#9da58d;margin:28px auto}.intro{text-align:center;max-width:590px;margin:0 auto 48px;line-height:1.8;color:#656b5f}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}figure{margin:0}.gallery a{display:block;overflow:hidden;border-radius:4px;background:#eeede5}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .3s}.gallery a:hover img{transform:scale(1.025)}figcaption{font-size:14px;padding:16px 0;color:#656b5f}footer{text-align:center;padding:32px;font-family:Georgia,serif;font-style:italic;color:#7a806e;border-top:1px solid #e4e5dc}.login{max-width:400px;margin:auto;padding:32px;background:#fff;border:1px solid #e4e5dc;border-radius:6px}label{display:block;margin-bottom:10px}input{font:inherit;width:100%;padding:12px;border:1px solid #8b927f;border-radius:3px}button{font:inherit;background:#555f49;color:white;padding:12px 24px;border:0;border-radius:3px;cursor:pointer}.login button{margin-top:20px;width:100%}.quiet{padding:0;background:transparent;color:inherit;text-decoration:underline;text-underline-offset:4px}.error{color:#923a32;line-height:1.5}.skip{position:absolute;top:-100px;left:12px}.skip:focus{top:12px;background:white;padding:12px;z-index:10}:focus-visible{outline:3px solid #798965;outline-offset:5px}@media(max-width:600px){header{padding:20px;align-items:flex-start}.brand{font-size:20px}nav{flex-direction:column;align-items:flex-end;gap:12px}main{padding:44px 20px}.gallery{grid-template-columns:1fr;gap:20px}}@media(prefers-reduced-motion:reduce){.gallery img{transition:none}}
</style>
