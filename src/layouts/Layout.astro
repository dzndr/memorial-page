---
interface Props { name: string; subtitle: string; theme: 'light' | 'dark' | 'auto'; }
const { name, subtitle, theme } = Astro.props;
---
<!doctype html>
<html lang="de" data-theme={theme}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="index, follow"/>
  <title>{name}</title>
</head>
<body>
  <main>
    <div class="heading">
      <span class="eyebrow">{subtitle}</span>
      <h1>{name}</h1>
    </div>
    <slot/>
  </main>
</body>
</html>
<style is:global>
:root{color-scheme:light dark;--background:light-dark(#faf9f5,#1c201b);--text:light-dark(#434840,#e0e3d9);--border:light-dark(#e4e5dc,#363d32);--muted:light-dark(#727865,#abb39e);--secondary:light-dark(#656b5f,#bcc3b2);--accent:light-dark(#9da58d,#89967b);--surface:light-dark(#fff,#252b22);--image-background:light-dark(#eeede5,#2b3127);--focus:light-dark(#798965,#b6ca9e);--footer:light-dark(#7a806e,#abb39e)}
:root[data-theme="light"]{color-scheme:light}
:root[data-theme="dark"]{color-scheme:dark}
:root{font-family:system-ui,sans-serif;color:var(--text);background:var(--background);font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}main{max-width:1920px;margin:auto;padding:64px 32px}.heading{text-align:center;margin-bottom:40px}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:.2em;color:var(--muted)}h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(32px,5vw,52px);line-height:1.15;margin:20px 0}.subtitle{font-size:clamp(24px,3vw,36px);line-height:1.2;color:var(--secondary);margin:8px 0 20px;font-weight:300}.line{display:block;width:44px;height:1px;background:var(--accent);margin:28px auto}.intro{text-align:center;max-width:590px;margin:0 auto 48px;line-height:1.8;color:var(--secondary)}.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;padding:16px}figure{margin:0}.gallery a{display:block;overflow:hidden;border-radius:4px;background:var(--image-background);aspect-ratio:1/1}.gallery img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .3s}.gallery a:hover img{transform:scale(1.025)}figcaption{font-size:14px;padding:16px 0;color:var(--secondary)}@media(max-width:600px){main{padding:44px 20px}.gallery{grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px}}@media(prefers-reduced-motion:reduce){.gallery img{transition:none}}
</style>
