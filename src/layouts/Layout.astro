---
interface Props { name: string; subtitle: string; theme: 'light' | 'dark' | 'auto'; favicon?: string; }
const { name, subtitle, theme, favicon } = Astro.props;
---
<!doctype html>
<html lang="de" data-theme={theme}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="index, follow"/>
  {favicon && <link rel="icon" href={favicon} />}
  <title>{name}</title>
</head>
<body>
  <main>
    <div class="heading">
      <span class="eyebrow">{subtitle}</span>
      <h1>{name}</h1>
    </div>
    <slot/>
  </main>
</body>
</html>
<style is:global>
:root {
  color-scheme: light dark;
  --background: light-dark(#faf9f5, #1c201b);
  --text: light-dark(#434840, #e0e3d9);
  --border: light-dark(#e4e5dc, #363d32);
  --muted: light-dark(#727865, #abb39e);
  --secondary: light-dark(#656b5f, #bcc3b2);
  --accent: light-dark(#9da58d, #89967b);
  --surface: light-dark(#fff, #252b22);
  --image-background: light-dark(#eeede5, #2b3127);
  --focus: light-dark(#798965, #b6ca9e);
  --footer: light-dark(#7a806e, #abb39e);
  font-family: system-ui, sans-serif;
  color: var(--text);
  background: var(--background);
  font-synthesis: none;
}

:root[data-theme="light"] {
  color-scheme: light;
}

:root[data-theme="dark"] {
  color-scheme: dark;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

a {
  color: inherit;
  text-underline-offset: 4px;
}

main {
  max-width: 1600px;
  margin: auto;
  padding: 32px;
}

.heading {
  margin-bottom: 32px;
  text-align: center;
}

.eyebrow {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

h1 {
  margin: 20px 0;
  font-family: Georgia, serif;
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 400;
  line-height: 1.15;
}

@media (max-width: 600px) {
  main {
    padding: 44px 8px;
  }
}
</style>
