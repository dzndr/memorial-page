---
interface Props { name: string; subtitle: string; }
const { name, subtitle } = Astro.props;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="index, follow"/>
  <title>{name} - {subtitle}</title>
  <script is:inline>
    (() => {
      let preference;
      try { preference = localStorage.getItem('theme'); } catch {}
      const theme = preference === 'light' || preference === 'dark'
        ? preference
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <main>
    <div class="heading">
      <span class="eyebrow">{subtitle}</span>
      <h1>{name}</h1>
    </div>
    <slot/>
  </main>
</body>
</html>
<script>
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  systemTheme.addEventListener('change', ({ matches }) => {
    let preference;
    try { preference = localStorage.getItem('theme'); } catch {}
    if (preference !== 'light' && preference !== 'dark') {
      document.documentElement.dataset.theme = matches ? 'dark' : 'light';
    }
  });
</script>
<style is:global>
:root{color-scheme:light;--background:#faf9f5;--text:#434840;--border:#e4e5dc;--muted:#727865;--secondary:#656b5f;--accent:#9da58d;--surface:#fff;--image-background:#eeede5;--focus:#798965;--footer:#7a806e}
:root[data-theme="dark"]{color-scheme:dark;--background:#1c201b;--text:#e0e3d9;--border:#363d32;--muted:#abb39e;--secondary:#bcc3b2;--accent:#89967b;--surface:#252b22;--image-background:#2b3127;--focus:#b6ca9e;--footer:#abb39e}
:root{font-family:system-ui,sans-serif;color:var(--text);background:var(--background);font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}main{max-width:1920px;margin:auto;padding:64px 32px}.heading{text-align:center;margin-bottom:40px}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:.2em;color:var(--muted)}h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(32px,5vw,52px);line-height:1.15;margin:20px 0}.subtitle{font-size:clamp(24px,3vw,36px);line-height:1.2;color:var(--secondary);margin:8px 0 20px;font-weight:300}.line{display:block;width:44px;height:1px;background:var(--accent);margin:28px auto}.intro{text-align:center;max-width:590px;margin:0 auto 48px;line-height:1.8;color:var(--secondary)}.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}figure{margin:0}.gallery a{display:block;overflow:hidden;border-radius:4px;background:var(--image-background)}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .3s}.gallery a:hover img{transform:scale(1.025)}figcaption{font-size:14px;padding:16px 0;color:var(--secondary)}@media(max-width:600px){main{padding:44px 20px}.gallery{grid-template-columns:1fr;gap:12px}}@media(prefers-reduced-motion:reduce){.gallery img{transition:none}}
</style>
