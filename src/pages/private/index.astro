---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { readFile } from 'node:fs/promises';
import { configuration, getSession } from '../../lib/auth.mjs';

const siteContent = JSON.parse(await readFile('.generated/manifest.json', 'utf8'));
const config = configuration();
const isLoggedIn = getSession(Astro.request, config);
---
<Layout title={siteContent.title} lifeDates={siteContent.lifeDates} privatePage isLoggedIn={isLoggedIn}><p class="intro">Erinnerungen, die wir im vertrauten Kreis teilen.</p><Gallery photos={siteContent.private}/></Layout>
