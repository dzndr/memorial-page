---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import publicContent from '../../build/public.json';

type Theme = 'light' | 'dark' | 'auto';
const theme = publicContent.theme as Theme;
---
<Layout name={publicContent.name} subtitle={publicContent.subtitle} theme={theme}>
  <Gallery photos={publicContent.public}/>
  <iframe data-testid="embed-iframe" style="position:fixed;bottom:0;left:0;right:0;width:100%;border:0" src="https://open.spotify.com/embed/track/7o6MC3gIIjI1NskrCuJabI?utm_source=generator&theme=0&si=f87b803fa6af4cdb" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
</Layout>
